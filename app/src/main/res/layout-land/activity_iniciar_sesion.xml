<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="15dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/inicio_sesion_layout"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.4"
        >
            <TextView
                android:id="@+id/inicio_sesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inicio_sesion"
                android:textAlignment="center"
                android:textColor="@color/texto_normal"
                android:textSize="32sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:id="@+id/descripcion_inicio_sesion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/descripcion_inicio_sesion"
                android:textAlignment="center"
                android:textColor="@color/texto_secundario"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/inicio_sesion"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardServer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fondo_secundario"
            app:cardCornerRadius="16dp"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/descripcion_inicio_sesion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/fondo_secundario"
                android:orientation="vertical"
                android:padding="20dp">



                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/used_server"
                    android:textSize="16sp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/serverSelection"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spacing="15dp"
                    app:boxBackgroundColor="@color/acento_de_fondo"
                    android:textColorHint="@color/texto_sobre_acento_de_fondo"
                    app:hintTextColor="@color/texto_sobre_acento_de_fondo"
                    app:selectionRequired="true"
                    app:singleSelection="true"
                    app:hintEnabled="false"
                    android:hint="@string/used_server">

                    <AutoCompleteTextView
                        android:id="@+id/serverSelectionTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:inputType="none"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:popupBackground="@drawable/selector_background"
                        android:textColor="@color/texto_sobre_acento_de_fondo"
                        tools:ignore="LabelFor" />

                </com.google.android.material.textfield.TextInputLayout>


                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/serverField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    android:visibility="gone"
                    tools:visibility = "visible">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/serverInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext"
                        android:hint="@string/placeholder_server"
                        android:inputType="text|textNoSuggestions"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:textColor="@color/texto_normal"
                        android:textColorHint="@color/texto_normal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fondo_secundario"
            app:cardCornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/inicio_sesion_layout"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/fondo_secundario"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/label_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/username_text"
                    android:textColor="@color/texto_normal"
                    android:textSize="20sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/usernameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:background="@drawable/edittext"
                        android:hint="@string/username_hint"
                        android:inputType="text|textNoSuggestions"
                        android:autofillHints="username"
                        android:textColor="@color/texto_normal"
                        android:textColorHint="@color/texto_normal" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/label_contrasenia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/password_text"
                    android:textColor="@color/texto_normal"
                    android:textSize="20sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:hintEnabled="false"
                    app:boxBackgroundMode="none"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/texto_normal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:background="@drawable/edittext"
                        android:hint="@string/password_hint"
                        android:inputType="textPassword"
                        android:textColor="@color/texto_normal"
                        android:textColorHint="@color/texto_normal" />
                </com.google.android.material.textfield.TextInputLayout>


                <Button
                    android:id="@+id/iniciar_sesion_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/login_button"
                    android:backgroundTint="@color/accent_color"
                    android:textColor="@color/texto_sobre_acento_de_fondo"
                    android:textSize="20sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/link_recuperar_contrasenia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="24dp"
                            android:clickable="true"
                            android:text="@string/link_text_recuperar_contrasenia"
                            android:textColor="@color/texto_normal"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/link_registrar_cuenta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:text="@string/link_text_registrar_cuenta"
                            android:textColor="@color/texto_normal"
                            android:textSize="16sp" />
                    </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/miPefilFragment"
    tools:context=".fragments.MiPerfilFragment"
    android:padding="15dp"
    android:paddingBottom="0dp">


    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/logroSelector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_group_background"
        app:selectionRequired="false"
        app:singleSelection="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/configuracionButton">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logrosConseguidosButton"
            style="@style/Theme.GreenQuest.ButtonGroupToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/logros_conseguidos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logrosFaltantesButton"
            style="@style/Theme.GreenQuest.ButtonGroupToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/logros_faltantes" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <Button
        android:id="@+id/configuracionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/acento_de_fondo"
        android:text="@string/Settings"
        android:textColor="@color/texto_oscuro"
        app:icon="@drawable/cog"
        app:iconGravity="textStart"
        app:iconTint="@color/texto_oscuro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerProfile" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/logros_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintEnd_toEndOf="@+id/logroSelector"
        app:layout_constraintStart_toStartOf="@+id/logroSelector"
        app:layout_constraintTop_toBottomOf="@+id/logroSelector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0"
        app:spanCount="2" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@drawable/secondary_card"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imagenDePerfil"
            android:contentDescription="@string/profile_image"
            android:gravity="center"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_marginEnd="10dp"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:layout_centerVertical="true"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/constraintLayout"
            tools:src="@tools:sample/avatars" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imagenDePerfil"
        app:layout_constraintTop_toTopOf="parent">


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/username_editperfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autoSizeMaxTextSize="16dp"
            android:autoSizeMinTextSize="10dp"
            android:autoSizeTextType="uniform"
            android:background="@drawable/edittext"
            android:hint="@string/username_hint"
            android:inputType="text|textNoSuggestions"
            android:textColor="@color/texto_normal"
            android:textColorHint="@color/texto_normal"
            app:layout_constraintStart_toStartOf="@id/descripcion_editperfil"
            app:layout_constraintEnd_toEndOf="@id/descripcion_editperfil"
            app:layout_constraintTop_toBottomOf="@+id/textView7" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/username"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/profile_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/username_editperfil" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/descripcion_editperfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginTop="4dp"
            android:autoSizeMaxTextSize="16dp"
            android:autoSizeMinTextSize="10dp"
            android:background="@drawable/edittext"
            android:hint="@string/descripcion_hint"
            android:inputType="textMultiLine"
            android:textAlignment="viewStart"
            android:textColor="@color/texto_normal"
            android:textColorHint="@color/texto_normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView8"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
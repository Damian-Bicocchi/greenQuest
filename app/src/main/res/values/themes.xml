<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GreenQuest" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:textColor">@color/texto_normal</item>
        <item name="android:textColorHint">@color/texto_normal</item>
        <item name="materialButtonStyle">@style/Widget.GreenQuest.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.GreenQuest.Button.Outlined</item>
        <item name="popupMenuStyle">@style/Widget.GreenQuest.PopupMenu</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.GreenQuest.MaterialAlertDialog</item>
        <item name="bottomNavigationStyle">@style/Widget.GreenQuest.BottomNavigationView</item>
        <item name="materialDividerStyle">@style/Widget.GreenQuest.MaterialDivider</item>
        <item name="colorPrimary">@color/accent_color</item>
        <item name="colorOnPrimary">@color/texto_normal</item>
        <item name="colorSecondary">@color/accent_color</item>
        <item name="colorOnSecondary">@color/texto_normal</item>
        <item name="colorTertiary">@color/accent_color</item>
        <item name="colorOnTertiary">@color/texto_normal</item>
        <item name="colorOutline">@android:color/transparent</item>
        <item name="android:windowBackground">@color/fondo_primario</item>
    </style>

    <style name="Widget.GreenQuest.MaterialDivider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">@color/acento_de_fondo</item>
    </style>

    <style name="Widget.GreenQuest.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/selector_background</item>
    </style>

    <style name="Theme.GreenQuest.ButtonGroupToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/fondo_secundario</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textColor">@color/button_group_text_selector</item>
        <item name="backgroundTint">@color/button_toggle_group_background_selector</item>
    </style>

    <style name="Theme.GreenQuest.ButtonGroupConnectedButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/fondo_secundario</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textColor">@color/button_group_text_selector</item>
        <item name="backgroundTint">@color/button_group_background_selector</item>
    </style>

    <style name="Widget.GreenQuest.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_color</item>
        <item name="android:textColor">@color/texto_sobre_acento_de_fondo</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.GreenQuest.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/accent_color</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="DialogTitleStyle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/texto_normal</item>
    </style>

    <style name="Widget.GreenQuest.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.GreenQuest.BottomNavigationView</item>
    </style>

    <style name="ThemeOverlay.GreenQuest.BottomNavigationView" parent="">
        <item name="colorOnSurface">@color/texto_oscuro</item>
        <item name="colorOnSurfaceVariant">@color/texto_oscuro</item>
        <item name="colorSurfaceContainer">@color/bottom_navigation_background</item>
        <item name="colorSecondaryContainer">@color/accent_color</item>
        <item name="colorOnSecondaryContainer">@color/texto_oscuro</item>
    </style>

    <style name="ThemeOverlay.GreenQuest.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent_color</item>
        <item name="colorSecondary">@color/accent_color</item>
        <item name="colorSurface">@color/fondo_primario</item>
        <item name="colorOnSurface">@color/texto_normal</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Material3</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.GreenQuest.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.GreenQuest.Button</item>
    </style>

    <style name="textTab" parent="TextAppearance.Design.Tab">
        <item name="android:textAllCaps">true</item>
        <item name="android:minLines">2</item>
    </style>
</resources>